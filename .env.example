# Copy to .env and edit. Real environment variables override this file.

# ---- Postgres + pgvector (docker compose up -d) ----
PG_USER=mm
PG_PASSWORD=mm
PG_DB=meeting_memory
PG_HOST=localhost
PG_PORT=5433
# or a full DSN: MM_PG_DSN=postgresql://mm:mm@localhost:5433/meeting_memory

# ---- Backend A: Claude CLI (default demo setup) ----
MM_LLM_BACKEND=claude_cli
MM_CLAUDE_AGENT_MODEL=sonnet
MM_CLAUDE_EXTRACT_MODEL=haiku
MM_CLAUDE_EXTRACT_EFFORT=low

# ---- Backend B: local model via Ollama / llama.cpp / LM Studio / vLLM ----
# Uncomment to switch. The agent then uses NATIVE TOOL CALLING (OpenAI `tools` API).
# Find your model tag with:  ollama list   (or pick one from https://ollama.com/search?c=tools)
# MM_LLM_BACKEND=openai
# MM_OPENAI_BASE_URL=http://localhost:11434/v1
# MM_OPENAI_MODEL=qwen3:8b
# MM_AGENT_TOOL_MODE=native          # native | json  (json = plain JSON-in-text protocol, works with any model)
# MM_OPENAI_JSON_MODE=1
# Small-model profile (keeps every call well inside an 8-16k context):
# MM_SEGMENT_WORDS=1200
# MM_AGENT_MAX_EVIDENCE_WORDS=3500
# MM_LEDGER_CONTEXT_ITEMS=30
# Ollama context window - set this in the environment of `ollama serve`, not here:
#   OLLAMA_CONTEXT_LENGTH=16384

# ---- Agent behaviour ----
MM_AGENT_DECOMPOSE=1                 # split multi-part questions into sub-questions
MM_AGENT_MAX_STEPS=6
MM_LLM_CONCURRENCY=6
